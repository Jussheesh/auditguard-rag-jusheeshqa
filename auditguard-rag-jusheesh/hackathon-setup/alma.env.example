# Use only if ALMA confirms an OpenAI-compatible API.
# No real credential belongs in this setup bundle.
USE_GOOGLE_GENAI=false
GEMINI_API_KEY=
LLM_BASE_URL=REPLACE_WITH_ALMA_BASE_URL
LLM_MODEL=REPLACE_WITH_EXACT_SERVED_MODEL_ID
# Non-secret placeholder for SDKs requiring a nonempty api_key argument.
LLM_API_KEY=alma-local
DEFAULT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Set FASTEMBED_CACHE_PATH to this folder's model-cache on the laptop.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
